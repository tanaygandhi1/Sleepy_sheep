{
  "manifest_version": 3,
  "name": "Sleepy Sheep",
  "version": "0.1.0",
  "description": "A cozy focus timer. A little sheep studies with you on every tab.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Sleepy Sheep",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms", "notifications", "activeTab", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
